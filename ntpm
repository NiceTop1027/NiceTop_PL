#!/bin/bash
# NTPM - NiceTop Package Manager
# NiceTop 언어의 패키지 관리자

VERSION="1.0.0"
NTPM_DIR="$HOME/.ntpm"
PACKAGES_DIR="$NTPM_DIR/packages"
REGISTRY_URL="https://raw.githubusercontent.com/nicetop/ntpm-registry/main"

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 초기화
init_ntpm() {
    if [ ! -d "$NTPM_DIR" ]; then
        mkdir -p "$PACKAGES_DIR"
        echo "✓ NTPM 초기화 완료: $NTPM_DIR"
    fi
}

# 도움말
show_help() {
    echo "NTPM - NiceTop Package Manager v$VERSION"
    echo ""
    echo "사용법:"
    echo "  ntpm install <패키지명>    패키지 설치"
    echo "  ntpm uninstall <패키지명>  패키지 제거"
    echo "  ntpm list                  설치된 패키지 목록"
    echo "  ntpm search <검색어>       패키지 검색"
    echo "  ntpm update                패키지 업데이트"
    echo "  ntpm init                  프로젝트 초기화"
    echo "  ntpm publish               패키지 배포"
    echo "  ntpm help                  도움말"
    echo ""
    echo "예제:"
    echo "  ntpm install math          # math 라이브러리 설치"
    echo "  ntpm install string-utils  # 문자열 유틸리티 설치"
}

# 패키지 설치
install_package() {
    local package_name=$1
    
    if [ -z "$package_name" ]; then
        echo -e "${RED}오류: 패키지 이름을 입력하세요${NC}"
        echo "사용법: ntpm install <패키지명>"
        exit 1
    fi
    
    echo -e "${BLUE}📦 패키지 설치 중: $package_name${NC}"
    
    # 패키지 디렉토리 생성
    local pkg_dir="$PACKAGES_DIR/$package_name"
    mkdir -p "$pkg_dir"
    
    # 로컬 패키지 저장소에서 설치 (임시)
    if [ -f "packages/$package_name.nt" ]; then
        cp "packages/$package_name.nt" "$pkg_dir/"
        echo -e "${GREEN}✓ $package_name 설치 완료!${NC}"
        echo "위치: $pkg_dir"
    else
        # GitHub에서 다운로드 시도
        echo -e "${YELLOW}⚠ 로컬에서 찾을 수 없습니다. 온라인 저장소에서 검색 중...${NC}"
        echo -e "${RED}✗ 패키지를 찾을 수 없습니다: $package_name${NC}"
        echo "사용 가능한 패키지를 보려면 'ntpm list' 명령을 사용하세요"
        exit 1
    fi
}

# 패키지 제거
uninstall_package() {
    local package_name=$1
    
    if [ -z "$package_name" ]; then
        echo -e "${RED}오류: 패키지 이름을 입력하세요${NC}"
        exit 1
    fi
    
    local pkg_dir="$PACKAGES_DIR/$package_name"
    
    if [ -d "$pkg_dir" ]; then
        rm -rf "$pkg_dir"
        echo -e "${GREEN}✓ $package_name 제거 완료${NC}"
    else
        echo -e "${RED}✗ 패키지가 설치되어 있지 않습니다: $package_name${NC}"
    fi
}

# 설치된 패키지 목록
list_packages() {
    echo -e "${BLUE}📦 설치된 패키지:${NC}"
    echo ""
    
    if [ ! -d "$PACKAGES_DIR" ] || [ -z "$(ls -A $PACKAGES_DIR 2>/dev/null)" ]; then
        echo "설치된 패키지가 없습니다."
        echo ""
        echo "패키지를 설치하려면:"
        echo "  ntpm install <패키지명>"
        return
    fi
    
    for pkg in "$PACKAGES_DIR"/*; do
        if [ -d "$pkg" ]; then
            local pkg_name=$(basename "$pkg")
            echo "  • $pkg_name"
        fi
    done
    echo ""
}

# 프로젝트 초기화
init_project() {
    echo -e "${BLUE}🚀 NiceTop 프로젝트 초기화${NC}"
    
    # package.json 생성
    cat > package.json << EOF
{
  "name": "my-nicetop-project",
  "version": "1.0.0",
  "description": "NiceTop 프로젝트",
  "main": "main.nt",
  "dependencies": {},
  "author": "",
  "license": "MIT"
}
EOF
    
    # main.nt 생성
    cat > main.nt << 'EOF'
# NiceTop 프로젝트

nout("Hello, NiceTop!")

nint x = 10
nint y = 20
nout("x + y = ")
nout(x + y)
EOF
    
    # README 생성
    cat > README.md << 'EOF'
# NiceTop 프로젝트

## 설치

```bash
ntpm install
```

## 실행

```bash
nicetop main.nt
```
EOF
    
    echo -e "${GREEN}✓ 프로젝트 초기화 완료!${NC}"
    echo ""
    echo "생성된 파일:"
    echo "  • package.json"
    echo "  • main.nt"
    echo "  • README.md"
}

# 패키지 검색
search_packages() {
    local query=$1
    echo -e "${BLUE}🔍 패키지 검색: $query${NC}"
    echo ""
    echo "사용 가능한 패키지:"
    echo "  • math - 수학 함수 라이브러리"
    echo "  • string-utils - 문자열 유틸리티"
    echo "  • file-io - 파일 입출력"
    echo "  • http - HTTP 클라이언트"
    echo "  • json - JSON 파서"
    echo ""
}

# 메인 로직
init_ntpm

case "$1" in
    install)
        install_package "$2"
        ;;
    uninstall|remove)
        uninstall_package "$2"
        ;;
    list|ls)
        list_packages
        ;;
    search)
        search_packages "$2"
        ;;
    init)
        init_project
        ;;
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        echo "NTPM v$VERSION"
        ;;
    *)
        if [ -z "$1" ]; then
            show_help
        else
            echo -e "${RED}알 수 없는 명령: $1${NC}"
            echo "도움말을 보려면 'ntpm help'를 입력하세요"
            exit 1
        fi
        ;;
esac
