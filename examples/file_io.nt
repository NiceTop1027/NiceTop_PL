# 파일 I/O 예제

nout("=== 파일 쓰기 ===")

# 파일 열기 (쓰기 모드)
nstring file1
file1 = nopen("output.txt", "w")

# 파일에 쓰기
nwrite(file1, "Hello from NiceTop!\n")
nwrite(file1, "This is line 2.\n")
nwrite(file1, "파일 I/O 테스트 성공!\n")

# 파일 닫기
nclose(file1)
nout("파일 작성 완료: output.txt")

nout("")
nout("=== 파일 읽기 ===")

# 파일 열기 (읽기 모드)
nstring file2
file2 = nopen("output.txt", "r")

# 파일 읽기
nstring content
content = nread(file2)

# 파일 닫기
nclose(file2)

nout("파일 내용:")
nout(content)
