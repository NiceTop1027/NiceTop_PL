# 파일 I/O 예제

nout("=== 파일 쓰기 ===")

# 파일 쓰기
nstring f = nopen("test_output.txt", "w")
nwrite(f, "Hello from NiceTop!\n")
nwrite(f, "Line 2\n")
nwrite(f, "Line 3\n")
nclose(f)
nout("파일 작성 완료!")

nout("")
nout("=== 파일 읽기 ===")

# 파일 읽기
nstring f2 = nopen("test_output.txt", "r")
nstring content = nread(f2)
nclose(f2)

nout("파일 내용:")
nout(content)
