# 함수 정의와 호출

# 간단한 함수
function greet(name) {
    print("안녕하세요, " + name + "님!")
}

greet("철수")
greet("영희")

# 반환값이 있는 함수
function add(a, b) {
    return a + b
}

let sum = add(10, 20)
print("합계: ")
print(sum)

# 재귀 함수 - 팩토리얼
function factorial(n) {
    if (n <= 1) {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

print("5! = ")
print(factorial(5))

# 피보나치 수열
function fibonacci(n) {
    if (n <= 1) {
        return n
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2)
    }
}

print("피보나치(10) = ")
print(fibonacci(10))
