# 절차(프로시저) 정의
function greet(name) {
    print("안녕하세요, " + name + "님!")
}

function calculate(a, b) {
    let sum = a + b
    let diff = a - b
    let prod = a * b
    
    print("합: ")
    print(sum)
    print("차: ")
    print(diff)
    print("곱: ")
    print(prod)
}

# 프로시저 호출
greet("철수")
greet("영희")

calculate(10, 5)
