# 배열 시뮬레이션 (변수로 구현)
# 절차지향 스타일

# 배열 요소들
let arr0 = 10
let arr1 = 20
let arr2 = 30
let arr3 = 40
let arr4 = 50

print("배열 요소들:")
print(arr0)
print(arr1)
print(arr2)
print(arr3)
print(arr4)

# 합계 계산
let sum = arr0 + arr1 + arr2 + arr3 + arr4
print("합계: ")
print(sum)

# 평균 계산
let avg = sum / 5
print("평균: ")
print(avg)
